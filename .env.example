# ==============================================================================
# TOBY'S AUTO MECHANIC — ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE: All these credentials can ALSO be configured and tested directly by Toby 
# inside the Admin Dashboard under "Settings & Automations" (stored in SQLite),
# meaning you don't even have to ask him for confidential keys!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5001
VITE_API_URL=/api

# ------------------------------------------------------------------------------
# 2. EMAIL AUTOMATION (EmailJS - https://www.emailjs.com)
# Free tier gives 200 emails/month, perfect for local auto repair shops.
# ------------------------------------------------------------------------------
# Your EmailJS Service ID (e.g. service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=

# Your EmailJS Public Key / Account ID (e.g. user_xxxxxxxxxxxx)
VITE_EMAILJS_PUBLIC_KEY=

# Template 1: Dispatches alert to Toby's shop email when a customer submits a request
VITE_EMAILJS_TEMPLATE_ID=

# Template 2: Automatically dispatches the official price quote back to the customer's email
VITE_EMAILJS_TEMPLATE_ID_QUOTE=

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT AUTOMATION (Instant Push Notifications to Phone)
# ------------------------------------------------------------------------------
# 1. Open Telegram, search @BotFather, send /newbot, name it "Toby's Shop Bot"
# 2. Copy the HTTP API token BotFather gives you
VITE_TELEGRAM_BOT_TOKEN=

# 3. Search @userinfobot on Telegram and press Start to get your numeric ID
VITE_TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 4. ADMIN ACCESS
# ------------------------------------------------------------------------------
# Initial master password to unlock the admin dashboard (default: toby2024)
# Toby can update his password anytime inside Admin -> Settings.
VITE_ADMIN_PASSWORD=toby2024
